# Copy to .env. Everything has a default for local use; change these for anything shared.
DB_PASSWORD=change-me
# "demo" seeds sample data into an empty database; use "default" for a real deployment
SPRING_PROFILES_ACTIVE=demo
# Optional: a super admin who can create admin accounts at /superadmin (disabled when empty)
SUPERADMIN_LOGIN_ID=
SUPERADMIN_PIN=
